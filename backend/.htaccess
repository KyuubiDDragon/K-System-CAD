RewriteEngine on
PassEnv CAD_ENABLED
# Disable all legacy CAD routes in Social-only mode, including entrypoints
# which do not load bootstrap.php. Social is still served by this backend.
RewriteCond %{ENV:CAD_ENABLED} =false
RewriteCond %{REQUEST_URI} !^/(api/)?social(/|$)
RewriteCond %{REQUEST_URI} !^/(api/)?health\.php$
RewriteRule ^ - [R=404,L]

RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Handle /api/ prefix by internally removing it
RewriteCond %{REQUEST_URI} ^/api/(.*)$
RewriteRule ^api/(.*)$ /$1 [QSA,L]

# Enabling CORS
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"

# Handle OPTIONS method
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule .* - [R=200,L]