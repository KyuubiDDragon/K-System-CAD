# .env.template - Produktions-Konfigurations-Vorlage (für Dokumentation)
# DIESE DATEI ENTHÄLT KEINE GEHEIMNISSE.
# Die tatsächlichen Werte (insbesondere die REQUIRED) MÜSSEN als Umgebungsvariablen
# in deiner Docker Umgebung (z.B. in Plesk) gesetzt werden.

# --- Anwendungs Umgebung ---
APP_ENV=production
# Mögliche Werte: production, development, testing...

# --- Datenbank Zugangsdaten (ALS SICHERE UMGEBUNGSVARIABLEN SETZEN! NICHT HIER EINFÜGEN!) ---
DB_HOST=db
# Beschreibt, wie das Backend die DB im Docker-Netzwerk findet.
# Wenn die DB woanders läuft (z.B. Managed Service), hier den Hostnamen/IP eintragen.

DB_PORT=3306
# Standard Port für MySQL.

DB_DATABASE=
# REQUIRED - Der Name der Datenbank.

DB_USERNAME=
# REQUIRED - Der Benutzername für die Datenbank.

DB_PASSWORD=
# REQUIRED - Das Passwort für den Datenbankbenutzer. SEHR SICHERES PASSWORT VERWENDEN!

DB_ROOT_PASSWORD=
# REQUIRED (Docker) - Das Root-Passwort für MariaDB. Wird nur beim ersten Start für die DB-Initialisierung benötigt.


# --- JWT Konfiguration ---
JWT_SECRET_KEY=
# REQUIRED - Ein langes, zufälliges, geheimes Passwort für die JWT-Signatur. ALS SICHERE UMGEBUNGSVARIABLE SETZEN!

JWT_EXPIRATION_TIME=3600
# Gültigkeitsdauer von JWTs in Sekunden (z.B. 3600 = 1 Stunde).

JWT_ISSUER="K-Systems"
# Der "Aussteller" des Tokens (oft die URL deiner App).

JWT_AUDIENCE="K-Systems"
# Für wen das Token bestimmt ist (oft die URL deiner App).


# --- Anwendungs URLs ---
# Die öffentliche URL des Backend-APIs (wird vom Frontend und evtl. intern genutzt).
APP_URL_PROD=
# REQUIRED - Beispiel: https://deine-domain.com/api

# Die öffentliche URL des Frontends (wird evtl. für CORS im Backend oder Links genutzt).
FRONTEND_URL_PROD=
# REQUIRED - Beispiel: https://deine-domain.com

# --- Cookie Einstellungen ---
COOKIE_DOMAIN=
# REQUIRED für Produktion. Setzen auf deine Domain (z.B. "deine-domain.com" oder ".deine-domain.com" für Subdomains). Leer lassen für localhost (nur Dev).

COOKIE_SECURE=true
# MUSS true sein, wenn über HTTPS (also in Produktion hinter Plesk) gearbeitet wird.

COOKIE_SAMESITE="Lax"
# Policy für SameSite Cookies. "Lax" oder "Strict" sind oft gute Standardwerte. "None" erfordert Secure=true und spezielle Browser-Behandlung.


# --- Socket.io Server Konfiguration ---
# Die interne URL, wie das Backend den Socket Server im Docker-Netzwerk findet.
SOCKET_SERVER_URL=http://socket-server:3001
# Nutzt den Docker Service Namen 'socket-server' und seinen internen Port 3001.

SOCKET_API_KEY=
# REQUIRED - Ein geheimes Passwort/Schlüssel für die Kommunikation Backend <-> Socket Server. ALS SICHERE UMGEBUNGSVARIABLE SETZEN!


# --- Upload Konfiguration ---
# Der Pfad INNERHALB des Containers, wo Uploads gespeichert werden.
# DIESER PFAD MUSS MIT EINEM DOCKER VOLUME VERBUNDEN SEIN, DAMIT UPLOADS PERSISTENT SIND!
UPLOAD_BASE_DIR=/var/www/html/uploads
# Stelle sicher, dass dies mit deinem Volume-Mount in docker-compose.yaml übereinstimmt
# und dass das Verzeichnis im Container existiert und beschreibbar ist.

# Die öffentliche URL, unter der auf Uploads zugegriffen werden kann (muss im Reverse Proxy konfiguriert werden).
PUBLIC_UPLOAD_URL=/upload


# --- Variable für Frontend Build ---
# Diese Variable wird vom Frontend Dockerfile.production über ARG verwendet,
# um die öffentlichen API/Socket URLs im Frontend-Build zu "verbacken".
CADDY_DOMAIN=
# REQUIRED - Setzen auf die öffentliche Domain, die von Plesk verwaltet wird (z.B. deine-domain.com).