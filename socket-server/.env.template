# socket-server/.env.template - Produktions-Konfigurations-Vorlage (für Dokumentation)
# DIESE DATEI ENTHÄLT KEINE GEHEIMNISSE.
# Die tatsächlichen Werte (insbesondere die REQUIRED) MÜSSEN als Umgebungsvariablen
# in deiner Docker Umgebung (z.B. in Plesk) gesetzt werden.

# --- Server Konfiguration ---
PORT=3001
# Interner Port des Node.js Servers (muss mit EXPOSE im Dockerfile übereinstimmen).

NODE_ENV=production
# Setzen auf 'production' für die Produktionsumgebung.

# --- JWT-Konfiguration ---
JWT_SECRET=
# REQUIRED - Geheimnis für JWT-Validierung. MUSS mit JWT_SECRET_KEY im Backend übereinstimmen!
# ALS SICHERE UMGEBUNGSVARIABLE SETZEN! NICHT HIER EINFÜGEN!

DISABLE_TOKEN_VALIDATION=false
# Validation aktivieren/deaktivieren. In Produktion auf 'false' lassen.

# --- API-Schlüssel ---
API_KEY=
# REQUIRED - API-Schlüssel für Backend -> Socket Server Kommunikation. MUSS mit SOCKET_API_KEY im Backend übereinstimmen!
# ALS SICHERE UMGEBUNGSVARIABLE SETZEN! NICHT HIER EINFÜGEN!

# --- CORS-Konfiguration ---
CORS_ORIGIN=
# REQUIRED für Produktion. Liste der erlaubten Origins (z.B. "https://deine-domain.com").
# Bei mehreren Origins Komma-separierte Liste (z.B. "https://origin1.com,https://origin2.com").
# Der Wert kommt aus der Env Var, die die öffentliche Frontend URL hält (z.B. https://${CADDY_DOMAIN}).


# --- PHP-Backend API-URL ---
PHP_API_URL=http://backend:80
# URL des Backend-APIs für interne Aufrufe vom Socket Server im Docker-Netzwerk.
# Nutzt den Docker Service Namen 'backend' und seinen internen Port 80.


# --- Debug/Logging ---
DEBUG=false
# Debug-Modus deaktivieren in Produktion. Setzen auf 'false' oder leer lassen.

LOG_LEVEL=info
# Log-Level in Produktion (error, warn, info). Nicht 'debug' oder 'silly'.

# --- Variable für öffentliche Domain (evtl. auch für CORS_ORIGIN nützlich) ---
# CADDY_DOMAIN= # Required, wenn CORS_ORIGIN darauf basiert (siehe oben)