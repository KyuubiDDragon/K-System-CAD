# frontend/.env.template - Frontend Konfigurations-Vorlage (für Dokumentation)
# DIESE DATEI ENTHÄLT KEINE GEHEIMNISSE.
# Die tatsächlichen Werte (insbesondere die REQUIRED) MÜSSEN als Umgebungsvariablen
# in deiner Docker Umgebung (z.B. in Plesk) gesetzt und als Build-Argumente an das Dockerfile übergeben werden.
# Dein Vite Build-Prozess muss so konfiguriert sein, dass er diese Variablen zur Build-Zeit aufnimmt.

# --- Anwendungs Titel ---
VITE_APP_TITLE="K-Systems"
# Standard-Titel der Anwendung.

# --- API und Socket URLs (für Produktion) ---
# Diese Variablen werden vom Frontend-Build benötigt, um die korrekten URLs "einzubacken".
# Sie sollten auf die öffentliche Domain zeigen, unter der dein Projekt erreichbar ist.
# Der Wert kommt aus der Umgebungsvariable CADDY_DOMAIN, die du in Plesk setzt.

VITE_API_URL=
# REQUIRED - Die öffentliche URL deines Backend-APIs.
# Beispiel: https://deine-domain.com/api
# Dies wird typischerweise im Dockerfile.production über Build-Args gesetzt:
# ARG VITE_API_URL
# RUN VITE_API_URL=${VITE_API_URL} npm run build

VITE_SOCKET_URL=
# REQUIRED - Die öffentliche URL deines Socket.io Servers (mit wss:// Protokoll!).
# Beispiel: wss://deine-domain.com/socket.io
# Dies wird typischerweise im Dockerfile.production über Build-Args gesetzt:
# ARG VITE_SOCKET_URL
# RUN VITE_SOCKET_URL=${VITE_SOCKET_URL} npm run build


# --- Redirect URL (nach Login etc.) ---
VITE_REDIRECT_URL=
# REQUIRED für Produktion. Die öffentliche Basis-URL deines Frontends.
# Beispiel: https://deine-domain.com


# --- Debug/Entwickler Tools ---
VITE_SHOW_DEV_TOOLS=false
# Steuert die Anzeige von Debugging-Informationen oder Entwickler-Tools in Produktion.
# Setzen auf 'false' für Produktion.


# --- Upload Konfiguration ---
# Die öffentliche URL, unter der auf Uploads zugegriffen werden kann (muss im Reverse Proxy konfiguriert werden).
PUBLIC_UPLOAD_URL=/backend/upload
# Dieser Pfad muss mit der Reverse Proxy Konfiguration in Plesk übereinstimmen.

# UPLOAD_BASE_DIR ist ein Backend-Konzept und gehört nicht ins Frontend .env.
# Das Frontend braucht nur die PUBLIC_UPLOAD_URL, um die Dateien anzuzeigen.


# --- Weitere Variablen (optional, falls benötigt) ---
# VITE_SOME_OTHER_VARIABLE=

# --- Variablen, die NICHT ins Template gehören oder nur für Dev sind ---
# PORT (Docker managed)
# NODE_ENV (Docker managed)
# CORS_ORIGIN (Socket Server handled CORS, Frontend braucht es hier nicht)
# JWT_SECRET / API_KEY etc. (Backend/Socket Server Geheimnisse)
# Lokale URLs (localhost:...)

# --- Variable für Build-Argumente (wird von Docker Compose/Plesk bereitgestellt) ---
# CADDY_DOMAIN= # REQUIRED - Die öffentliche Domain (z.B. deine-domain.com)
# Diese Variable wird in Plesk gesetzt und von docker-compose.yml als Build-Arg an das Frontend Dockerfile übergeben.
# Sie wird verwendet, um VITE_API_URL und VITE_SOCKET_URL zu konstruieren.
