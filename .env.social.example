# Merge into your existing installation .env; retain existing database and JWT secrets.
COMPOSE_PROFILES=social
SOCIAL_ENABLED=true
CAD_ENABLED=true
SOCIAL_URL=https://social.example.com
SOCIAL_DOMAIN=social.example.com
SOCIAL_ORIGIN=https://social.example.com
SOCIAL_STORAGE=local
# Optional private S3 bucket. Existing files remember their original provider.
SOCIAL_S3_ENDPOINT=
SOCIAL_S3_REGION=us-east-1
SOCIAL_S3_BUCKET=
SOCIAL_S3_KEY=
SOCIAL_S3_SECRET=
